# Supabase — 프로젝트 vtkeruqexphuvritwkyt (vidding-re)
# 대시보드 → Project Settings → API 에서 복사한다.
#
# 이 파일을 .env.local 로 복사해서 값을 채운다. .env* 는 .gitignore 에 있다.

NEXT_PUBLIC_SUPABASE_URL=https://vtkeruqexphuvritwkyt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 시드 스크립트 전용. RLS 를 우회하므로 브라우저로 새어나가면 안 된다.
# Vercel 환경 변수에는 넣지 않는다 — 앱은 이 키를 쓰지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 웹 푸시 (VAPID). `npx web-push generate-vapid-keys` 로 만든다.
# 공개 키는 브라우저 구독에, 비밀 키는 발송 서명에 쓴다. 셋 다 Vercel 에도 넣는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# DB 트리거(pg_net)가 /api/push 를 부를 때 맞춰야 하는 값.
# Supabase Vault 의 push_webhook_secret 과 같아야 한다 (20260803000003_push.sql)
PUSH_WEBHOOK_SECRET=
