# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 없는 견본은 커밋한다 — 워크트리마다 무엇을 채워야 하는지 알아야 한다
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/worktrees/

# 로컬 작업용 폰트 원본 (배포에 쓰는 파일은 src/app/fonts/ 에 있다)
/PretendardVariable.woff2

# 디자인 — 제출물은 design.pen 하나다
# 리뷰용으로 내보낸 화면 이미지
design/exports/
# Pencil 캔버스가 쓰는 폰트 사본
design/*.woff2

# storybook
/storybook-static
*storybook.log
